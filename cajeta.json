{
    // dev.cajeta.xref — the compiler's `--emit-xref` cross-reference index as
    // a typed library: normalized `owner::name/argc` symbol keys, call edges,
    // the override relation, and method declarations.
    //
    // A LIBRARY project has NO `main` / no `entry-method`: it compiles to a
    // reusable `.cja` archive that other projects depend on (via
    // settings.dependencies), rather than a native executable. The only
    // structural difference from the `basic` (binary) archetype is the
    // absence of `settings.build.entry-method` — with no entry point the
    // build action emits a `.cja` library instead of an exe.
    //
    // Why each cut happened, newest first:
    //
    //   0.2.0 — the first cut with a gate behind it. 0.1.0 shipped with the
    //     starter's `dev-dependencies` and `test` task untouched, so `cajeta
    //     test` had never once run; the suite added under src/test found
    //     XrefDoc.parseFile SEGV on a missing path, against its own doc
    //     comment, because File.readAllBytes answers NULL rather than
    //     throwing. Measured on the released v0.28.0 and v0.27.0 toolchains
    //     alike, so it is a defect of this package and not of either.
    //     MINOR rather than PATCH because the declared capability set changes
    //     with it, from the starter's empty list to `filesystem`, and that set
    //     is unioned into every consumer's required capabilities.
    //
    // There is deliberately NO `settings.toolchain` pin. The fleet's rule for
    // that block is that a stale value is a false claim about what builds, and
    // a claim of 0.28.0 would be exactly that: both the library and the whole
    // test suite were MEASURED green on the released v0.27.0 as well
    // (25 xref tests, 0 failed), so nothing in this tree sets a 0.28.0 floor.
    // Add the block when something here actually needs one, and name it.

    "details": {
        "name":               "dev.cajeta.xref",
        "version":            "0.2.0",
        "description":        "cajeta-xref — the compiler's --emit-xref cross-reference index as a typed library",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Declare only what the library's public API actually needs;
        // capabilities are re-validated against the consumer's manifest at the
        // point of use, and they are unioned into the consumer's required set.
        //
        // `filesystem`, not the starter's empty list: `XrefDoc.parseFile`
        // reads the document off disk (File.readAllBytes, XrefDoc.cajeta:182),
        // which is the library's entire entry point. 0.1.0 published an empty
        // list beside that call, so a consumer reading this manifest to decide
        // what to grant was told the wrong thing.
        "capabilities": ["filesystem"],

        // Third-party runtime dependencies. The core stdlib (cajeta.lang,
        // cajeta.io, cajeta.codec, …) is built into the toolchain — neither
        // declared nor fetched — and only the parts your code uses are linked
        // into a consumer's binary (dead-code elimination).
        "dependencies": {},

        // Test-only dependencies — not shipped in the published .cja.
        //
        // `cajeta.testkit` was the `init library` starter's placeholder and has
        // never existed on Olla (/v2/resolve answers "package 'cajeta.testkit'
        // not found"), so the pin resolved to nothing and the test task had no
        // test binary to run. The fleet's test dependency is dev.cajeta.unit.
        //
        // 0.2.6, not the 0.2.5 the registry serves today: 0.2.5 was cut one
        // commit before its own ownership fix, and linking it under cajeta
        // v0.28.0 fails the whole test build with
        // CAJETA_ERROR_CAPTURED_BORROW_PARAM on `PredMatcher.pred` before a
        // single test runs. 0.2.6 is the first unit release this toolchain can
        // compile against.
        "dev-dependencies": {
            "dev.cajeta.unit": "0.2.6"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` here — that is what makes this a library. With an
        // entry point the build emits an exe; without one it emits a .cja.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            // Delegates to ./run-tests.sh. The starter's inline action pair
            // asked the `build` action for a test-profile artifact and handed
            // its path to `test`, but a LIBRARY build emits no test binary, so
            // `${art.path}` came back empty and every run of this task died on
            // "test: missing required 'input' (path to test binary)". The
            // suite has to be compiled as an EXECUTABLE from src/test with the
            // library and cajeta-unit on the classpath, and resolving that
            // cajeta-unit archive (store -> sha256-verified Olla fetch) is
            // shell work this action list cannot express.
            "description": "Build + run the library's unit tests",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
