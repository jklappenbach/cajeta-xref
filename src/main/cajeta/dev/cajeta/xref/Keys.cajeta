package dev.cajeta.xref;

import cajeta.lang.String;
import cajeta.lang.StringBuilder;

/**
 * Symbol-key normalization for the compiler's cross-reference world.
 *
 * The `--emit-xref` document and the compiler's IR mangle the same method two
 * different ways:
 *
 *     xref:  probe.Cond::both(int32,int32)          (types only)
 *     IR:    both(b:int32,a:int32)                  (name:type pairs)
 *
 * Both normalize here to `probe.Cond::both/2` — owner, name, and ARITY.
 * Collapsing overloads to arity is a deliberate bias: when two same-arity
 * overloads collapse, a reference to either marks both live, so an analysis
 * built on these keys can *miss* dead code but can never claim a live method
 * is dead. Tools whose findings say "delete this" need exactly that error
 * direction.
 */
public class Keys {

    /**
     * Normalize `pkg.Class::name(args...)` — either spelling — to
     * `pkg.Class::name/argc`. Input without a parameter list passes through
     * unchanged. Argument counting tracks `(`/`<` nesting, so a template
     * argument's comma (`HashMap<int32,int64>`) is not a parameter boundary.
     */
    public static #String normalize(String qualified) {
        int64 open = Keys.indexOf(qualified, 40, 0);          // '('
        if (open < 0) {
            return qualified.substring(0, qualified.byteLength());
        }
        int32 argc = 0;
        int32 depth = 0;
        boolean any = false;
        int32 i = (int32) open + 1;
        int32 n = qualified.byteLength();
        while (i < n) {
            int8 c = qualified.byteAt(i);
            if (c == 40 || c == 60) { depth = depth + 1; }     // ( <
            else if (c == 62) { depth = depth - 1; }           // >
            else if (c == 41) {                                // )
                if (depth == 0) { i = n; }
                else { depth = depth - 1; }
            }
            if (i < n) {
                if (c != 41 || depth != 0) {
                    if (c > 32) { any = true; }
                    if (c == 44 && depth == 0) { argc = argc + 1; }
                }
                i = i + 1;
            }
        }
        if (any) { argc = argc + 1; }

        StringBuilder sb = stack StringBuilder();
        sb.append(qualified.substring(0, (int32) open));
        sb.append("/");
        sb.append(Keys.decimal((int64) argc));
        return sb.toString();
    }

    /** Normalized key for a split owner + method signature. */
    public static #String keyOf(String owner, String method) {
        StringBuilder sb = stack StringBuilder();
        sb.append(owner);
        sb.append("::");
        sb.append(method);
        String q #= sb.toString();
        return Keys.normalize(q);
    }

    /** First index of byte `b` at or after `from`, or -1. */
    static int64 indexOf(String s, int32 b, int64 from) {
        int32 n = s.byteLength();
        int64 i = from;
        while (i < n) {
            if ((int32) s.byteAt((int32) i) == b) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** Decimal rendering, self-contained (no dependency beyond the stdlib). */
    static #String decimal(int64 v) {
        if (v == 0) { return "0"; }
        int64 x = v;
        int8[] tmp #= heap int8[24];
        int32 w = 0;
        while (x > 0) {
            tmp[w] = (int8) (48 + (int32) (x % 10));
            x = x / 10;
            w = w + 1;
        }
        int8[] outb #= heap int8[w];
        int32 o = 0;
        int32 k = w;
        while (k > 0) {
            outb[o] = tmp[k - 1];
            o = o + 1;
            k = k - 1;
        }
        return heap String(#outb, w);
    }
}
